<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <RootNamespace>LiveStreamSound.App</RootNamespace>
    <AssemblyName>LiveStreamSound</AssemblyName>
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>
    <!--
      Needed so `dotnet publish -c Release -r win-x64` (self-contained) in CI has the
      restored assets for that RID. Non-breaking on macOS dev builds that don't set -r.
    -->
    <RuntimeIdentifiers>win-x64</RuntimeIdentifiers>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\LiveStreamSound.Shared\LiveStreamSound.Shared.csproj" />
    <ProjectReference Include="..\LiveStreamSound.Host\LiveStreamSound.Host.csproj" />
    <ProjectReference Include="..\LiveStreamSound.Client\LiveStreamSound.Client.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.0" />
    <PackageReference Include="WPF-UI" Version="3.0.5" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="Assets\app.ico">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <!--
      Ship LICENSE + THIRD_PARTY_LICENSES + Notfall-Plan alongside the binary
      so the MSI carries them into Program Files, the WiX wildcard
      <Files Include="$(AppPublishDir)**" /> picks them up automatically,
      and uninstall removes them cleanly. Required for license compliance
      (NAudio MS-PL, Concentus BSD-3 etc.) when redistributing on locked-
      down school AD environments where the user can't reach the GitHub
      repo to view the licenses online.
    -->
    <Content Include="..\..\LICENSE" Link="LICENSE">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
    <Content Include="..\..\THIRD_PARTY_LICENSES.txt" Link="THIRD_PARTY_LICENSES.txt">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
    <Content Include="..\..\docs\Notfall-Plan.md" Link="docs\Notfall-Plan.md">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
  </ItemGroup>

</Project>
